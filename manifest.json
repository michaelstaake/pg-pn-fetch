{
  "manifest_version": 3,
  "name": "PartsGeek Fetch Real Part Numbers",
  "version": "0.4",
  "description": "Shows the real manufacturer part number on PartsGeek listings and remembers past lookups.",
  "author": "PupSierra",
  "browser_specific_settings": {
    "gecko": {
      "id": "partsgeek-fetch-real-pn@pupsierra",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_title": "PartsGeek Fetch Real Part Numbers",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.partsgeek.com/*",
    "*://partsgeek.com/*"
  ],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://www.partsgeek.com/*", "*://partsgeek.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
